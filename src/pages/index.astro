---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CarteMariage from '../components/CarteMariage.astro';
import Film from '../components/Film.astro';
import Contact from '../components/Contact.astro';
import { site, prestations, films, accueil } from '../data/site';
import { dateMois, trierMariages } from '../data/format';

const mariages = trierMariages(await getCollection('mariages'));
const enUne = mariages.find((m) => m.data.slug === accueil.mariageEnUne) ?? mariages[0];
const recents = mariages.slice(0, 6);
const og = await getImage({ src: enUne.data.hero, width: 1200, format: 'jpg', quality: 80 });

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#site`,
      url: `${site.url}/`,
      name: site.nom,
      inLanguage: 'fr',
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#hugo`,
      name: site.nom,
      jobTitle: site.metier,
      url: `${site.url}/`,
      email: site.email,
      telephone: site.telephone,
      sameAs: [site.instagram, site.facebook],
    },
  ],
};
---

<Base
  title="Photographe et vidéaste de mariage en Hainaut et dans le Nord | Hugo Gillard"
  description="Reportages photo et films de mariage en Hainaut, dans le Nord de la France et au-delà. Environ 700 photos retouchées, teaser et film d'environ 10 minutes. Découvrez des mariages complets."
  image={og.src}
  jsonld={jsonld}
>
  <figure class="une">
    <Image
      src={enUne.data.hero}
      alt={enUne.data.heroAlt}
      widths={[800, 1200, 1600]}
      sizes="100vw"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      style={`view-transition-name: photo-${enUne.data.slug}`}
    />
    <figcaption class="conteneur legende">
      <a href={`/mariages/${enUne.data.slug}/`}>Mariage de {enUne.data.couple}</a>{enUne.data.date && `, ${dateMois(enUne.data.date)}`}
    </figcaption>
  </figure>

  <section class="conteneur presentation">
    <h1>Photographe et vidéaste de mariage en Hainaut et dans le Nord de la France</h1>
    <div class="prose">
      <p>
        Je m'appelle Hugo Gillard. Je photographie et je filme des mariages en Belgique et dans le Nord de la France, des
        préparatifs jusqu'à la pièce montée.
      </p>
      <p>
        Le jour J, je reste discret. Je photographie ce qui se passe, et je vous guide seulement le temps de quelques
        portraits.
      </p>
    </div>
    <p class="actions">
      <a class="bouton" href="#contact">Vérifier ma date</a>
      <a href="/mariages/">Voir les mariages</a>
    </p>
  </section>

  <section class="section" aria-labelledby="titre-recents">
    <div class="conteneur">
      <div class="section-tete">
        <h2 id="titre-recents">Mariages récents</h2>
        <a href="/mariages/">Tous les mariages</a>
      </div>
      <div class="cartes">
        {recents.map((m) => <CarteMariage mariage={m} />)}
      </div>
    </div>
  </section>

  <section class="section" id="films" aria-labelledby="titre-films">
    <div class="conteneur">
      <div class="section-tete">
        <h2 id="titre-films">Les films</h2>
        <p class="legende">Les teasers de quatre mariages. Le film complet dure environ dix minutes.</p>
      </div>
      <div class="films">
        {
          films.map((f) => (
            <div class="film-bloc">
              <Film id={f.id} titre={`Teaser du mariage de ${f.couple}`} />
              <p>
                {f.mariage ? <a href={`/mariages/${f.mariage}/`}>{f.couple}</a> : f.couple}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="prestations" aria-labelledby="titre-prestations">
    <div class="conteneur">
      <div class="section-tete">
        <h2 id="titre-prestations">Prestations</h2>
      </div>
      <div class="tableau">
        <table>
          <thead>
            <tr><th scope="col">Formule</th><th scope="col">Ce qui est inclus</th><th scope="col">Prix</th></tr>
          </thead>
          <tbody>
            {
              prestations.map((p) => (
                <tr>
                  <th scope="row">{p.nom}</th>
                  <td>{p.inclus.join(', ')}</td>
                  <td class="prix">{p.prix ? `À partir de ${p.prix}` : 'Sur demande'}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="prose suite">
        Le prix dépend de la formule et du lieu. Envoyez-moi votre date et l'endroit pour en parler.
      </p>
    </div>
  </section>

  <Contact />
</Base>

<style>
  .une {
    margin: 0;
  }
  .une :global(img) {
    width: 100%;
    max-height: 86vh;
    object-fit: cover;
  }
  .une figcaption {
    padding-top: 10px;
  }
  .une figcaption a {
    color: var(--encre-2);
  }
  .presentation {
    display: grid;
    gap: 20px;
    padding-block: clamp(36px, 5vw, 64px) clamp(48px, 7vw, 88px);
  }
  .presentation h1 {
    max-width: 22ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
  }
  .cartes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 44px) clamp(16px, 2vw, 28px);
  }
  .films {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(20px, 2.4vw, 32px);
  }
  .film-bloc {
    display: grid;
    gap: 10px;
    min-width: 0;
  }
  .tableau {
    overflow-x: auto;
    border-top: 1px solid var(--encre);
  }
  table {
    width: 100%;
    border-collapse: collapse;
  }
  th,
  td {
    text-align: left;
    vertical-align: top;
    padding: 14px 16px 14px 0;
    border-bottom: 1px solid var(--filet);
  }
  thead th {
    font-weight: 500;
    color: var(--encre-2);
    font-size: 0.9rem;
  }
  tbody th {
    font-weight: 600;
    white-space: nowrap;
  }
  .prix {
    white-space: nowrap;
  }
  .suite {
    margin-top: 24px;
  }
  @media (max-width: 900px) {
    .cartes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 700px) {
    .films {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
