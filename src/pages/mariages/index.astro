---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CarteMariage from '../../components/CarteMariage.astro';
import { site } from '../../data/site';
import { trierMariages } from '../../data/format';

const mariages = trierMariages(await getCollection('mariages'));

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Mariages', item: `${site.url}/mariages/` },
  ],
};
---

<Base
  title="Mariages photographiés et filmés | Hugo Gillard"
  description={`${mariages.length} mariages photographiés par Hugo Gillard, photographe et vidéaste de mariage en Hainaut et dans le Nord de la France. Chaque page suit la journée dans l'ordre.`}
  jsonld={jsonld}
>
  <div class="conteneur">
    <header class="tete">
      <h1>Mariages</h1>
      <p class="prose">
        Les mariages que j'ai photographiés, et parfois filmés, ces derniers mois. Chaque page suit la journée dans
        l'ordre, des préparatifs à la soirée.
      </p>
    </header>
    <div class="cartes">
      {mariages.map((m, i) => <CarteMariage mariage={m} prioritaire={i < 3} />)}
    </div>
  </div>
</Base>

<style>
  .tete {
    display: grid;
    gap: 14px;
    padding-block: clamp(32px, 5vw, 64px) 36px;
  }
  .cartes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(28px, 3vw, 44px) clamp(16px, 2vw, 28px);
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  @media (max-width: 900px) {
    .cartes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
