---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

const lignes = [
  ['Nom', site.legal.denomination ?? site.nom],
  ['Adresse', site.legal.adresse],
  ["Numéro d'entreprise (BCE)", site.legal.bce],
  ['Numéro de TVA', site.legal.tva],
].filter((l): l is [string, string] => Boolean(l[1]));
---

<Base title="Mentions légales | Hugo Gillard" description="Informations légales sur l'éditeur et l'hébergeur de hugogillardpro.com.">
  <article class="conteneur page-texte">
    <h1>Mentions légales</h1>
    <div class="prose">
      <h2>Éditeur du site</h2>
      <dl>
        {
          lignes.map(([cle, valeur]) => (
            <div>
              <dt>{cle}</dt>
              <dd>{valeur}</dd>
            </div>
          ))
        }
        <div><dt>E-mail</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
        <div><dt>Téléphone</dt><dd><a href={`tel:${site.telephone}`}>{site.telephoneAffiche}</a></dd></div>
      </dl>

      <h2>Hébergement</h2>
      <p>GitHub Pages, GitHub Inc., 88 Colin P. Kelly Jr. Street, San Francisco, CA 94107, États-Unis.</p>

      <h2>Photos et films</h2>
      <p>
        Les photos et les films publiés sur ce site sont l'œuvre de {site.nom}. Toute reproduction demande son accord
        écrit.
      </p>

      <h2>Données personnelles</h2>
      <p>Voir la page <a href="/confidentialite/">Confidentialité et cookies</a>.</p>
    </div>
  </article>
</Base>

<style>
  .page-texte {
    display: grid;
    gap: 28px;
    padding-block: clamp(32px, 5vw, 64px) clamp(48px, 7vw, 96px);
  }
  .prose :global(h2) {
    font-size: 1.25rem;
    margin-top: 1.6em;
  }
  dl {
    display: grid;
    gap: 8px;
  }
  dl div {
    display: grid;
    grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
    gap: 12px;
  }
  dt {
    font-family: var(--titre);
    color: var(--encre-2);
  }
  dd {
    margin: 0;
  }
  @media (max-width: 560px) {
    dl div {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
