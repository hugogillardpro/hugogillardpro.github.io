---
import { site } from '../data/site';
---

<div class="consentement" id="consentement" data-ads-id={site.googleAds.id} hidden>
  <div class="conteneur interieur" role="region" aria-label="Cookies">
    <p>
      J'utilise un traceur Google Ads pour savoir quelles annonces amènent des demandes de contact. Il ne se charge que si
      vous l'acceptez. <a href="/confidentialite/">En savoir plus</a>
    </p>
    <div class="choix">
      <button type="button" class="bouton bouton-discret" data-choix="refuse">Refuser</button>
      <button type="button" class="bouton bouton-discret" data-choix="accepte">Accepter</button>
    </div>
  </div>
</div>

<style>
  .consentement {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    background: var(--blanc);
    border-top: 1px solid var(--filet);
    padding-block: 16px calc(16px + env(safe-area-inset-bottom, 0px));
    box-shadow: 0 -4px 18px rgb(0 0 0 / 0.06);
  }
  .interieur {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: 0.95rem;
  }
  .interieur p {
    max-width: 52rem;
  }
  .choix {
    display: flex;
    gap: 10px;
  }
</style>

<script>
  const CLE = 'hg-consentement';
  const bandeau = document.getElementById('consentement') as HTMLElement | null;
  const idAds = bandeau?.dataset.adsId ?? '';

  type Gtag = (...args: unknown[]) => void;
  const w = window as unknown as { dataLayer: unknown[]; gtag?: Gtag; hgConsentement?: () => boolean };

  function lire(): string | null {
    try {
      return localStorage.getItem(CLE);
    } catch {
      return null;
    }
  }

  function ecrire(valeur: string) {
    try {
      localStorage.setItem(CLE, valeur);
    } catch {
      /* stockage indisponible : le choix vaut pour cette page */
    }
  }

  let charge = false;
  function chargerGoogleAds() {
    if (charge || !idAds) return;
    charge = true;
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () {
      // eslint-disable-next-line prefer-rest-params
      w.dataLayer.push(arguments);
    };
    w.gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
    });
    w.gtag('consent', 'update', {
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted',
    });
    const s = document.createElement('script');
    s.async = true;
    s.src = `https://www.googletagmanager.com/gtag/js?id=${idAds}`;
    document.head.appendChild(s);
    w.gtag('js', new Date());
    w.gtag('config', idAds);
  }

  function appliquer(choix: string) {
    ecrire(choix);
    if (bandeau) bandeau.hidden = true;
    if (choix === 'accepte') chargerGoogleAds();
    else if (w.gtag) {
      w.gtag('consent', 'update', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
      });
    }
  }

  w.hgConsentement = () => lire() === 'accepte';

  const choix = lire();
  if (choix === 'accepte') chargerGoogleAds();
  else if (choix !== 'refuse' && bandeau) bandeau.hidden = false;

  bandeau?.querySelectorAll<HTMLButtonElement>('[data-choix]').forEach((b) => {
    b.addEventListener('click', () => appliquer(b.dataset.choix ?? 'refuse'));
  });

  document.querySelectorAll<HTMLButtonElement>('[data-ouvrir-consentement]').forEach((b) => {
    b.addEventListener('click', () => {
      if (!bandeau) return;
      bandeau.hidden = false;
      bandeau.querySelector<HTMLButtonElement>('[data-choix="refuse"]')?.focus();
    });
  });
</script>
