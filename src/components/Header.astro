---
const chemin = Astro.url.pathname;
const liens = [
  { href: '/mariages/', label: 'Mariages' },
  { href: '/#films', label: 'Films' },
  { href: '/#prestations', label: 'Prestations' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="entete">
  <div class="conteneur barre">
    <a class="logo" href="/">
      <span class="logo-nom">Hugo Gillard</span>
      <span class="logo-metier">photo et film de mariage</span>
    </a>
    <nav aria-label="Navigation principale">
      <ul>
        {
          liens.map((l) => (
            <li>
              <a href={l.href} aria-current={chemin.startsWith(l.href) && l.href !== '/' ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="bouton cta" href="/#contact">Vérifier ma date</a>
  </div>
</header>

<style>
  .entete {
    border-bottom: 1px solid var(--filet);
    background: var(--mur);
  }
  .barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 28px;
    padding-block: 16px;
  }
  .logo {
    display: grid;
    color: var(--encre);
    text-decoration: none;
    line-height: 1.2;
  }
  .logo-nom {
    font-weight: 600;
    font-size: 1.1rem;
  }
  .logo-metier {
    font-size: 0.875rem;
    color: var(--encre-2);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    color: var(--encre);
    text-decoration: none;
    padding-block: 6px;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .cta {
    padding: 10px 16px;
    font-size: 0.95rem;
  }
  @media (max-width: 720px) {
    nav {
      order: 3;
      width: 100%;
    }
    .cta {
      padding: 9px 12px;
    }
  }
</style>
