---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { dateMois, lieuTexte } from '../data/format';

interface Props {
  mariage: CollectionEntry<'mariages'>;
  prioritaire?: boolean;
}

const { mariage, prioritaire = false } = Astro.props;
const d = mariage.data;
const infos = [lieuTexte(d), dateMois(d.date), d.film ? 'photo et film' : 'photo'].filter(Boolean).join(', ');
---

<a class="carte" href={`/mariages/${d.slug}/`}>
  <Image
    src={d.couverture}
    alt=""
    widths={[360, 540, 720]}
    sizes="(min-width: 1100px) 30vw, (min-width: 640px) 45vw, 90vw"
    format="webp"
    quality={78}
    loading={prioritaire ? 'eager' : 'lazy'}
    style={`view-transition-name: photo-${d.slug}`}
  />
  <span class="nom">{d.couple}</span>
  <span class="infos">{infos}</span>
</a>

<style>
  .carte {
    display: grid;
    gap: 6px;
    color: var(--encre);
    text-decoration: none;
    min-width: 0;
  }
  .carte :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    margin-bottom: 6px;
    background: var(--filet);
  }
  .nom {
    font-weight: 600;
    font-size: 1.1rem;
    text-decoration: underline;
    text-decoration-color: var(--filet);
    text-underline-offset: 4px;
  }
  .carte:hover .nom {
    text-decoration-color: var(--encre);
  }
  .infos {
    font-size: 0.9rem;
    color: var(--encre-2);
  }
</style>
